<div class="container-fluid page__container">
  <div class="row">
    <div class="col-md-12">
      <div class="card">
        <%= form_for current_user, url: organisation_profile_path(current_user),  html: { class: 'form-horizontal user-form-validation', 'data-parsley-validate' => true } do |f| %>
          <div class="card-form__body card-body">
            <%= render 'organisation/profiles/partials/fields', f: f %>
          </div>
          <div class="card-body text-center">
            <%= f.submit 'Save Changes', class: 'btn btn-success' %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
