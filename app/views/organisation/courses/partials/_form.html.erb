<div class="container-fluid page__container">
  <div class="row">
    <div class="col-md-12">
      <div class="card">
        <%= simple_form_for [:organisation, @course], html: { class: 'form-horizontal' } do |f| %>
          <div class="card-form__body card-body">
            <div class="form-group">
              <%= f.label :title %>
              <%= f.text_field :title, class: 'form-control', placeholder: 'Please Enter Title', required: true %>
            </div>
            <div class="form-group">
              <%= f.label :subtitle %>
              <%= f.text_field :subtitle, class: 'form-control', placeholder: 'Please Enter Title', required: true %>
            </div>
            <div class="form-group">
              <%= f.label :description %>
              <%= f.text_area :description, class: 'form-control', placeholder: 'Please enter description', required: true %>
            </div>
            <div class="form-group">
              <label for="subscribe">Published</label><br>
              <div class="custom-control custom-checkbox-toggle custom-control-inline mr-1">
                <%= f.check_box :status, { class: 'custom-control-input', checked: @course.published? }, 'published', 'un_published' %>
                <%= f.label :status, '', class: 'custom-control-label' %>
              </div>
              <%= f.label :status, 'Published', class: 'mb-0' %>
            </div>
            <div class="form-group">
              <label>Course Preview</label>
              <div class="dz-clickable media align-items-center" data-toggle="dropzone" data-dropzone-url="http://" data-dropzone-clickable=".dz-clickable" data-dropzone-files="[&quot;assets/images/account-add-photo.svg&quot;]">
                <div class="dz-preview dz-file-preview dz-clickable mr-3">
                  <div class="avatar avatar-lg dz-error dz-complete">
                    <%= image_tag @course.image.attached? ? url_for(@course.image) : 'account-add-photo.svg',  class: 'avatar-img rounded', data: { 'dz-thumbnail' => '' } %>
                  </div>
                </div>
                <div class="media-body">
                  <%= f.file_field :image, class: 'btn btn-sm dz-clickable' %>
                </div>
              </div>
            </div>
          </div>
          <div class="card-body text-center">
            <%= f.submit 'Save Changes', class: 'btn btn-success' %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
