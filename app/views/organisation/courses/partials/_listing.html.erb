<% if courses.present? %>
  <table class="table mb-0 thead-border-top-0">
    <thead>
      <tr>
        <th class="text-center">SR.</th>
        <th class="text-center">LOGO</th>
        <th class="text-center">TITLE</th>
        <th class="text-center">STATUS</th>
        <th class="text-center" colspan="3">ACTION</th>
      </tr>
    </thead>
    <tbody class="list" id="staff">
      <% courses&.each_with_index do |course, index| %>
      <tr class="text-center">
        <td><%= (index+1) %></td>
        <td>
          <%= link_to organisation_course_path(course), class: 'avatar w-xs-plus-down-100' do %>
            <%= image_tag(url_for(course.image_path), controls: true, class: 'avatar-course-img') %>
          <% end %>
        </td>
        <td><%= course.title&.titleize %></td>
        <td><%= course.status&.titleize %></td>
        <td>
        <% if course.deleted_at.blank? %>
          <%= link_to 'Show', organisation_course_path(course), class: 'btn btn-primary custom-size-btn' %>  |
          <%= link_to 'Edit', edit_organisation_course_path(course), class: 'btn btn-warning custom-size-btn' %> |
          <%= link_to 'Destory', organisation_course_path(course), method: :delete, class: 'btn btn-danger custom-size-btn' %>
        <% else %>
          <%=link_to 'Restore', restore_organisation_course_path(course), method: :delete, class: 'btn btn-warning custom-size-btn' %>
         <% end %>
        </td>
      </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <h3 class="not-found">NOT FOUND</h3>
<% end %>

