<div class="container-fluid page__heading-container">
  <div class="page__heading d-flex align-items-center justify-content-between">
    <h1 class="m-0">Payment Details</h1>
  </div>
</div>

<div class="container-fluid page__container">
  <div class="card card-form">
    <div class="row no-gutters">
      <div class="col-md-12 card-form__body card-body">
        <form action="#">
          <div class="form-group">
            <label for="">Full Name</label>
            <div class="input-group input-group-merge">
              <input type="text" class="form-control form-control-appended" required="" placeholder="Full Name">
            </div>
          </div>
          <div class="form-group">
            <label for="">Credit Card Number</label>
            <div class="input-group input-group-merge">
              <input type="text" class="form-control form-control-appended" required="" placeholder="Credit Card Number">
            </div>
          </div>
          <div class="row">
            <div class="col-md-6">
              <div class="form-group">
                <label class="text-label" for="flatpickrSample01">Expiration Date</label>
                <input class="form-control flatpickr-input" placeholder="MM/YY" tabindex="0" type="text" readonly="readonly">
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-group">
                <label for="">CVV</label>
                <div class="input-group input-group-merge">
                  <input type="text" class="form-control form-control-appended" required="" placeholder="CVV">
                </div>
              </div>
            </div>
          </div>
          <div class="text-right">
            <%= link_to 'Cancel', '#', class: 'btn btn-dark ml-1 custom-size-btn' %>
            <%= link_to 'Save', '#', class: 'btn btn-warning mx-1 custom-size-btn' %>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>