<% if students.present? %>
  <table class="table mb-0 thead-border-top-0">
    <thead>
      <tr>
        <th class="text-center">Sr</th>
        <th class="text-center">IMAGE</th>
        <th class="text-center">NAME</th>
        <th class="text-center">CONTACT</th>
        <th class="text-center">BIRTHDATE</th>
        <th class="text-center" colspan="3">ACTION</th>
      </tr>
    </thead>
    <tbody class="list" id="staff">
      <% students&.each_with_index do |student, index| %>
      <tr class="text-center">
        <td><%= (index+1) %></td>
        <td>
          <%= link_to organisation_student_path(student), class: 'avatar w-xs-plus-down-100' do %>
            <%= image_tag(url_for(student.image_path), controls: true, class: 'avatar-course-img') %>
          <% end %>
        </td>
        <td><%= student&.full_name&.titleize %></td>
        <td><%= student&.contact %></td>
        <td><%= student&.birth_date&.to_date %></td>
        <td>
        <% if student.deleted_at.blank? %>
          <%= link_to 'show', organisation_student_path(student), class: 'btn btn-primary custom-size-btn' %>  |
          <%= link_to 'edit', edit_organisation_student_path(student), class: 'btn btn-warning custom-size-btn' %> |
          <%= link_to 'destroy', organisation_student_path(student), method: :delete, class: 'btn btn-danger custom-size-btn' %>
        <%else %>
          <%=link_to 'restore', restore_organisation_student_path(student), method: :delete, class: 'btn btn-warning custom-size-btn' %>
         <%end%>
        </td>
      </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <h3 class="not-found">NOT FOUND</h3>
<% end %>
