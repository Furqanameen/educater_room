<div class="container-fluid page__container">
  <div class="row">
    <div class="col-md-12">
      <div class="card">
        <%= simple_form_for [:organisation, @section], html: { class: 'form-horizontal'} do |f| %>
          <div class="card-form__body card-body">
            <div class="form-group">
              <%= f.label :batch_id %>
              <%= f.select(:batch_id, @batches.map { |batch| [batch.title&.titleize, batch.id] }, { include_blank: 'Please select Batch', selected: f.object.batch_id }, class: 'form-control input-lg', required: true) %>
            </div>
            <%= render 'organisation/sections/partials/fields', f: f %>
          </div>
          <div class="card-body text-center">
            <%= f.submit 'Save Changes', class: 'btn btn-success' %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
