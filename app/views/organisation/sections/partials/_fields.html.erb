<div class="form-group">
  <%= f.label :title %>
  <%= f.text_field :title, class: 'form-control', placeholder: 'Please Enter Title', required: true %>
</div>
<div class="form-group">
  <%= f.label :description %>
  <%= f.text_area :description, class: 'form-control', placeholder: 'Please enter description', required: true %>
</div>
<div class="courses_portion">
  <div class="course_sections">
    <h3 class="mb-4">Courses and Instructors</h3>
    <%= f.simple_fields_for :course_sections do |course_section| %>
      <%= render 'organisation/nested_fields/course_section_fields', f: course_section %>
    <% end %>
  </div>
  <div class="form-group">
    <%= link_to_add_association 'Add Course and Instructor', f, :course_sections, partial: 'organisation/nested_fields/course_section_fields', class: 'btn btn-primary', data: { association_insertion_node: '.course_sections', association_insertion_method: :append } %>
  </div>
</div>
