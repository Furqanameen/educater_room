<div class="container-fluid page__heading-container">
  <div class="page__heading d-flex flex-column flex-md-row align-items-center justify-content-center justify-content-lg-between text-center text-lg-left">
    <h1 class="m-0">Sections</h1>
    <%= link_to 'New Section', new_organisation_section_path, class: 'btn btn-success ml-lg-3' %>
  </div>
</div>

<div class="container page__container">
  <div class="row no-gutters">
    <div class="col-md-12">
      <div class="card">
        <div class="card-header card-header-large bg-light d-flex align-items-center">
          <div class="flex">
            <h4 class="card-header__title">Sections</h4>
          </div>
          <% if @sections.present? %>
            <div class="d-flex mb-2">
              <div class="form-inline ml-auto">
                <div class="form-group">
                  <label class="form-label mr-1">Filter: </label>
                  <%= select_tag 'batch', options_for_select(@batches.map { |batch| [batch.title.titleize, batch.id] }),{ include_blank: 'Select Batch', class: 'form-control section-search-filter ml-lg-2', id: 'section-search-batch' } %>
                </div>
                <div class="form-group">
                  <%= select_tag 'option', options_for_select([['All', 'all'], ['Deleted', 'deleted']]), { include_blank: 'Select Option', class: 'form-control section-search-filter ml-lg-2', id: 'section-search-constraint' } %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
        <div class="card-body" id="section-card">
          <%= render 'organisation/sections/partials/listing', sections: @sections %>
        </div>
      </div>
    </div>
  </div>
</div>
