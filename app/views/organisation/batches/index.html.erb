<div class="container-fluid page__heading-container">
  <div class="page__heading d-flex flex-column flex-md-row align-items-center justify-content-center justify-content-lg-between text-center text-lg-left">
    <h1 class="m-0">Batches</h1>
    <%= link_to 'New Batch', new_organisation_batch_path, class: 'btn btn-success ml-lg-3' %>
  </div>
</div>

<div class="container page__container">
  <div class="row no-gutters">
    <div class="col-md-12">
      <div class="card">
        <div class="card-header card-header-large bg-light d-flex align-items-center">
          <div class="flex">
            <h4 class="card-header__title">Batches</h4>
          </div>
          <% if @batches.present? %>
            <div class="d-flex mb-2">
              <div class="form-inline ml-auto">
                <div class="form-group">
                  <label class="form-label mr-1">Filter: </label>
                  <%= text_field_tag :start_date, '', class: 'form-control flat-date batch-search-filter ml-lg-2', placeholder: 'From Start Date', id: 'batch-search-start-date' %>
                  <%= text_field_tag :end_date, '', class: 'form-control flat-date batch-search-filter ml-lg-2', placeholder: 'To End Date', id: 'batch-search-end-date' %>
                </div>
                <div class="form-group">
                  <%= select_tag('option', options_for_select([['All', 'all'], ['Deleted', 'deleted']]), { include_blank: 'Select Option', class: 'form-control batch-search-filter ml-lg-2 select2', id: 'batch-search-constraint' }) %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
        <div class="card-body" id="batch-card">
          <%= render 'organisation/batches/partials/listing', batches: @batches %>
        </div>
      </div>
    </div>
  </div>
</div>
