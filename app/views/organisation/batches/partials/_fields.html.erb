<div class="form-group">
  <%= f.label :title %>
  <%= f.text_field :title, class: 'form-control', placeholder: 'Please Enter Title', required: true %>
</div>
<div class="form-group">
  <%= f.label :description %>
  <%= f.text_field :description, class: 'form-control', placeholder: 'Please enter description', required: true %>
</div>
<div class="form-group">
  <%= f.label :start_date %>
  <%= f.text_field :start_date, class: 'form-control flat-date', placeholder: 'Please Select Date', required: true %>
</div>
<div class="form-group">
  <%= f.label :end_date %>
  <%= f.text_field :end_date, class: 'form-control flat-date', placeholder: 'Please Select Date', required: true %>
</div>

<div class="sections_portion">
  <div class="sections">
    <h3>Sections:</h3>
    <%= f.simple_fields_for :sections do |section| %>
      <%= render 'organisation/nested_fields/section_fields', f: section %>
    <% end %>
  </div>

  <div class="form-group">
    <%= link_to_add_association 'Add Section', f, :sections, class: 'btn btn-primary', partial: 'organisation/nested_fields/section_fields', data: { association_insertion_node: '.sections', association_insertion_method: :append } %>
  </div>
  <hr>
</div>