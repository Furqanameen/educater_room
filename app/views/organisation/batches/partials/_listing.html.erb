<% if batches.present? %>
  <table class="table mb-0 thead-border-top-0">
    <thead>
      <tr>
        <th class="text-center">TITLE</th>
        <th class="text-center">SECTIONS</th>
        <th class="text-center">START DATE</th>
        <th class="text-center">END DATE</th>
        <th class="text-center" colspan="3">ACTION</th>
      </tr>
    </thead>
    <tbody class="list" id="staff">
      <% batches&.each do |batch| %>
      <tr class="text-center">
        <td><%= batch.title&.titleize %></td>
        <td><%= batch.sections&.length %></td>
        <td><%= batch.start_date&.to_date %></td>
        <td><%= batch.end_date&.to_date %></td>
        <td>
        <% if batch.deleted_at.blank? %>
          <%= link_to 'show', organisation_batch_path(batch), class: 'btn btn-primary custom-size-btn' %>  |
          <%= link_to 'edit', edit_organisation_batch_path(batch), class: 'btn btn-warning custom-size-btn' %> |
          <%= link_to 'destroy', organisation_batch_path(batch), method: :delete, class: 'btn btn-danger custom-size-btn' %>
        <% else %>
          <%=link_to 'restore', restore_organisation_batch_path(batch), method: :delete, class: 'btn btn-warning custom-size-btn' %>
         <% end %>
        </td>
      </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <h3 class="not-found">NOT FOUND</h3>
<% end %>
