<div class="container-fluid page__container">
  <div class="row">
    <div class="col-md-12">
      <div class="card">
        <%= simple_form_for [:organisation, @batch], html: { class: 'form-horizontal' } do |f| %>
          <div class="card-form__body card-body">
            <%= render 'organisation/batches/partials/fields', f: f %>
          </div>
          <div class="card-body text-center">
            <%= f.submit 'Save Changes', class: 'btn btn-success' %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
