<div class="container-fluid page__heading-container">
  <div class="page__heading d-flex flex-column flex-md-row align-items-center justify-content-center justify-content-lg-between text-center text-lg-left">
    <h1 class="m-lg-0">Lessons</h1>
    <%= link_to 'New Lesson', new_instructor_course_section_lesson_path, class: 'btn btn-success ml-lg-2' %>
  </div>
</div>

<div class="container-fluid page__container">
  <div class="row lessons">
    <div class="col-md-12">
      <div class="card">
        <div class="card-header card-header-large bg-light d-flex align-items-center">
          <div class="flex">
            <h4 class="card-header__title">Lesson</h4>
          </div>
          <% if @lessons.present? %>

            <div class="d-flex mb-2">
              <div class="form-inline ml-auto">
               <div class="form-group">
                 <%#= select_tag 'section', options_for_select(@sections.map { |section| [section.title.titleize, section.id] }),{ include_blank: 'Select Section', class: 'form-control lesson-search-filter ml-lg-2', id: 'lesson-search-section' } %>
                 <%#= select_tag 'course', options_for_select(@courses.map { |course| [course.title.titleize, course.id] }),{ include_blank: 'Select Course', class: 'form-control lesson-search-filter ml-lg-2', id: 'lesson-search-course' } %>
               </div>
                <div class="form-group">
                  <%= select_tag('option', options_for_select([['All', 'all'], ['Deleted', 'deleted']]), { include_blank: 'Select Option', class: 'form-control lesson-search-filter ml-lg-2', id: 'lesson-search-constraint' }) %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
        <div class="card-body" id="lessons-card">
          <%= render 'instructor/lessons/partials/listing', course_section: @course_section, lessons: @lessons %>
        </div>
      </div>
    </div>
  </div>
</div>
