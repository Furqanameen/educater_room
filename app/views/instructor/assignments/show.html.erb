<div class="container page__heading-container">
  <div class="page__heading d-flex align-items-center justify-content-between">
    <h1 class="m-0">Show page of Assignment</h1>
  </div>
</div>

<div class="container page__container show-details">
  <div class="row">
    <div class="col-md-12">
      <div class="card card__course">
        <div class="row">
          <div class="col-md-4">
            <div class="card-header card-header-large card-header-dark bg-dark d-flex justify-content-center">
              <span class="card-header__title  justify-content-center align-self-center d-flex flex-column">FILE HERE</span>
            </div>
          </div>
          <div class="col-md-8">
            <div class="py-3 pr-3">
              <div class="mb-2">
                <div class="row">
                  <div class="col-md-6">
                    <span class="title">Title</span>
                    <h5 class="mb-3"><%= @assignment&.title.titleize %></h5>
                  </div>
                  <div class="col-md-6">
                    <span class="title">Description</span>
                    <h5 class="mb-3"><%= @assignment&.description %></h5>
                  </div>
                </div>
                <div class="row">
                  <div class="col-md-6">
                    <span class="title">Start Date</span>
                    <p class="text-capitalize"><%= humanize_time @assignment&.start_date %></p>
                  </div>
                  <div class="col-md-6">
                    <span class="title">End Date</span>
                    <p class="text-capitalize"><%= humanize_time @assignment&.end_date %></p>
                  </div>
                </div>
              </div>
              <div class="btns text-right">
                <%= link_to 'Edit', edit_instructor_course_section_assignment_path(@course_section), class: 'btn btn-warning ml-lg-2 custom-size-btn' %>
                <%= link_to 'Back', instructor_course_section_assignments_path(@course_section), class: 'btn btn-dark ml-lg-2 custom-size-btn' %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
