<div class="nested-fields">
  <div class="form-group">
    <%= f.label :title %>
    <%= f.text_field :title, class: 'form-control', required: true %>
  </div>

  <div class="form-group">
    <%= f.label :description %>
    <%= f.text_field :description, class: 'form-control', required: true %>
  </div>

  <div class="form-group">
    <%= f.label :start_date %>
    <%= f.date_field :start_date, class: 'form-control flatpickr-datetime', placeholder: 'Please Select Date', required: true %>
  </div>

  <div class="form-group">
    <%= f.label :end_date %>
    <%= f.date_field :end_date, class: 'form-control  flatpickr-datetime', placeholder: 'Please Select Date', required: true %>
  </div>

  <div class="form-group">
    <%= f.label :files, 'Add Files' %>
    <%= f.file_field :files, multiple: true, class: 'form-control', required: true, data: { validates: { required: {} } } %>
  </div>
</div>
