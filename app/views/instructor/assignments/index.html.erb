<div class="container-fluid page__heading-container">
  <div class="page__heading d-flex flex-column flex-md-row align-items-center justify-content-center justify-content-lg-between text-center text-lg-left">
    <h1 class="m-lg-0">Assignments</h1>
    <%= link_to 'New Assignments', new_instructor_course_section_assignment_path, class: 'btn btn-success ml-lg-2' %>
  </div>
</div>

<div class="container-fluid page__container">
  <div class="row assignments">
    <div class="col-md-12">
      <div class="card">
        <div class="card-header card-header-large bg-light d-flex align-items-center">
          <div class="flex">
            <h4 class="card-header__title">Assignments</h4>
          </div>
          <% if @assignments.present? %>

            <div class="d-flex mb-2">
              <div class="form-inline ml-auto">
                <div class="form-group">
                  <label class="form-label mr-1">Filter: </label>
                  <%= text_field_tag :start_date, '', class: 'form-control flatpickr-datetime assignment-search-filter ml-lg-2', placeholder: 'From Start Date', id: 'assignment-search-start-date' %>
                  <%= text_field_tag :end_date, '', class: 'form-control flatpickr-datetime assignment-search-filter ml-lg-2', placeholder: 'To End Date', id: 'assignment-search-end-date' %>
                </div>
                <div class="form-group">
                  <%= select_tag('option', options_for_select([['All', 'all'], ['Deleted', 'deleted']]), { include_blank: 'Select Option', class: 'form-control assignment-search-filter ml-lg-2', id: 'assignment-search-constraint' }) %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
        <div class="card-body" id="assignments-card">
          <%= render 'instructor/assignments/partials/listing', course_section: @course_section, assignments: @assignments %>
        </div>
      </div>
    </div>
  </div>
</div>
