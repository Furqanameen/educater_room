<%= form_for [:instructor, course_section, quiz] do |form| %>
  <%= render 'shared/errors', instance: quiz %>

  <div>
    <%= render 'instructor/quizzes/partials/quiz_fields', f: form %>
  </div>

  <div class="actions">
    <%= form.submit 'Save Changes', class: 'btn btn-success' %>
  </div>
<% end %>
