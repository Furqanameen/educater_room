<div class="nested-fields">
  <div class="form-group">
    <%= f.label :title %>
    <%= f.text_field :title, class: 'form-control', required: true %>
  </div>

  <div class="form-group">
    <%= f.label :description %>
    <%= f.text_field :description, class: 'form-control', required: true %>
  </div>

  <div class="form-group">
    <%= f.label :start_date %>
    <%= f.date_field :start_date, class: 'form-control', required: true %>
  </div>

  <div class="form-group">
    <%= f.label :end_date %>
    <%= f.date_field :end_date, class: 'form-control', required: true %>
  </div>

  <div id="question_fields">
    <h2>Questions</h2>
    <%= f.fields_for :questions do |question| %>
      <%= render 'instructor/quizzes/partials/question_fields', f: question %>
    <% end %>
    <%= link_to_add_association 'Add Question', f, :questions, class: 'btn btn-success', partial: 'instructor/quizzes/partials/question_fields' %>
  </div>
</div>
