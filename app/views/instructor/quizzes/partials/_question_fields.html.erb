<div class="nested-fields">
  <h2>Add a question</h2>
  <div class="form-group">
    <%= f.label :statement %>
    <%= f.text_field :statement, class: 'form-control', required: true %>
  </div>

  <div class="form-group">
    <%= f.label :question_type %>
    <%= f.select :question_type, Question.question_types.map { |key, value| [key.humanize, value] }, { include_blank: 'Please select city' }, class: 'form-control select2' %>
  </div>

  <div id="answer_fields">
    <h2>Answers</h2>
    <%= f.fields_for :answers do |answer| %>
      <%= render 'instructor/quizzes/partials/answer_fields', f: answer %>
    <% end %>
    <%= link_to_add_association 'Add Answer', f, :answers, class: 'btn btn-success', partial: 'instructor/quizzes/partials/answer_fields' %>
  </div>

  <div class="form-group text-right">
    <%= link_to_remove_association 'Remove Question', f, class: 'btn bg-danger text-white btn-sm border-0' %>
  </div>
</div>

