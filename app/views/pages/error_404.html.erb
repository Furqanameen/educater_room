<div class="error-pages">
  <div class="box">
    <div class="holder">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-sm-8">
            <div class="card">
              <div class="card-header card-header-large bg-white">
                <h4 class="card-header__title text-center">
                  <div class="image-logo text-center">
                    <%= link_to root_path do %>
                      <%= image_tag 'logos/dark-logo.png' %>
                    <% end %>
                  </div>
                </h4>
              </div>
              <div class="card-body text-center">
                <div class="card-text">
                  <h4>Error 404</h4>
                  <p class="mb-2">The page you are looking for does not exist.</p>
                  <p>You may have mistyped the address or the page may have moved.</p>
                  <%= link_to 'Back To Home', root_path, class: 'btn btn-sm btn-primary' %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>