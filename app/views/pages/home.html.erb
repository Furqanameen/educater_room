<%= render 'shared/public_partials/register' %>

<div class="contact-us-form card-form__body card-body py-5" id="contact-us">
  <div class="row justify-content-md-center">
    <div class="col-sm-8 contact-us">
      <h2 class="bold text-center mb-1">Get In Touch</h2>
      <p class="lead text-center mb-5">We are here to help and answer any question if you might have. We look forward to hear from you</p>
      <div class="row">
        <div class="col-md-10 mx-auto">
          <form>
            <div class="form-row">
              <div class="col-sm-6 mb-4">
                <input type="text" class="form-control custom-form" placeholder="FIRST NAME">
              </div>
              <div class="col-sm-6 mb-4">
                <input type="text" class="form-control custom-form" placeholder="LAST NAME">
              </div>
            </div>
            <div class="form-row">
              <div class="col-sm-6 mb-4">
                <input type="email" class="form-control custom-form" placeholder="YOUR EMAIL">
              </div>
              <div class="col-sm-6 mb-4">
                <input type="text" class="form-control custom-form" placeholder="YOUR PHONE">
              </div>
            </div>
            <div class="form-row">
              <div class="col-sm-12 mb-4">
                <textarea class="form-control custom-text-area" placeholder="YOUR MESSAGE" rows="6"></textarea>
              </div>
            </div>
            <div class="text-right custom-btn"><button type="submit" class="btn btn-primary btn-rounded gradient-bg">Send Message <i class="fa fa-chevron-right"></i></button></div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
