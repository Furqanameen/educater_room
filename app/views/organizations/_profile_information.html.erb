<h6><span class="number mr-1">1</span> Tell us about your Organization</h6>
<section>
  <div class="row">
    <div class="col-sm-12">
      <div class="block-head text-center mb-5">
        <p class="mb-2">Step 1</p>
        <h3>Your Profile</h3>
      </div>
      <div class="row">
        <div class="form-group col-sm-6">
          <%= f.label :first_name %>
          <%= f.text_field :first_name, class: 'form-control required' %>
        </div>
        <div class="form-group col-sm-6">
          <%= f.label :last_name %>
          <%= f.text_field :last_name, class: 'form-control required' %>
        </div>
      </div>
      <div class="row">
        <div class="form-group col-sm-12">
          <%= f.label :email %>
          <%= f.email_field :email, class: 'form-control required' %>
        </div>
        <div class="form-group col-sm-12">
          <%= f.label :password %>
          <%= f.password_field :password, class: 'form-control required' %>
        </div>
      </div>
    </div>
  </div>
</section>
