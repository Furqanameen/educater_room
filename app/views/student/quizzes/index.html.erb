<div class="block-content">
  <table class="table table-striped admin-table">
    <thead>
      <tr>
        <th>Course</th>
        <th>Section</th>
        <th>Title</th>
        <th>Start Date</th>
        <th>End Date</th>
        <th class="text-center">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @quizzes.each_with_index do |quiz, index|%>
        <tr >
          <td><%= quiz&.course_section&.course&.title&.humanize %></td>
          <td><%= quiz&.course_section&.section&.title&.humanize %></td>
          <td><%= quiz&.title&.humanize %></td>
          <td><%= quiz&.start_date.strftime("%FT%T") %></td>
          <td><%= quiz&.end_date.strftime("%FT%T") %></td>
          <td class="text-center">
            <%= link_to 'Quiz Questions',student_course_section_quiz_path(quiz.course_section,quiz), class: 'btn btn-success'%>
          </td>
        </tr>
      <%end%>
    </tbody>
  </table>
</div>
