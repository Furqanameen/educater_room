<!DOCTYPE html>
<html>
  <head>
    <title>Brightersroom</title>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag 'brightersroom', media: 'all' %>
    <%= stylesheet_link_tag 'org_public', media: 'all' %>
    <%= favicon_link_tag 'favicon.ico' %>
  </head>

  <body class="layout-fluid layout-sticky-subnav">
    <div id="app-settings">
      <app-settings layout-active="fluid"></app-settings>
    </div>

    <%= render partial: 'shared/loader' %>

    <div class="mdk-header-layout js-mdk-header-layout">
      <div class="mdk-header-layout__content page">
        <div id="content-wrapper" class="home-page-container">
          <%= yield %>
        </div>
      </div>
    </div>

    <%= javascript_include_tag 'brightersroom' %>
    <%= javascript_include_tag 'org_public' %>
  </body>
</html>
